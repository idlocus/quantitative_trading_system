# 复制为 .env 并按需修改；所有项均有代码内默认值（见 config/system_config.py 与 risk/constants.py）

# 数据源类型: wind | akshare | winddb
DATA_SOURCE_TYPE=akshare

# 回测区间与资金
START_DATE=2023-01-01
END_DATE=2026-02-27
INITIAL_CAPITAL=100000
COMMISSION=0.0003
# 单边滑点比例（0.001 = 0.1%）
SLIPPAGE=0.0

# 退出系统（0 = 关闭对应机制）
STOP_LOSS=0.03
TAKE_PROFIT=0.06
TRAILING_STOP=0.05
MAX_HOLDING_DAYS=20

# Wind Oracle DB（板块筛选，可选）
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# QMT 实盘交易（接入实盘时填入，Paper 模式不需要）
QMT_PATH=C:\国金QMT交易端\userdata_mini
QMT_ACCOUNT_ID=你的资金账号
QMT_SESSION_ID=1
